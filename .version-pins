# ISL 0.24 is GCC's own pinned prerequisite (contrib/download_prerequisites,
# base_url https://gcc.gnu.org/pub/gcc/infrastructure/). 0.28 is published only
# on SourceForge, which intermittently returns 522; 0.24 has first-class,
# non-SourceForge mirrors (gcc.gnu.org + sourceware.org), so the CI download
# never depends on SourceForge.
ISL_VER=0.24
